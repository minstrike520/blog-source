.centered-wrapper {
  /* Define a size for your wrapper */
  width: 60%;
  max-width: 600px; /* Optional: Set a max size */

  /* Center the content (the image) using Flexbox */
  display: flex;
  justify-content: center; /* Centers horizontally */
  align-items: center; /* Centers vertically */

  /* Optional: Add a border/background to visualize the wrapper */
  border: 2px dashed #ccc; 
  margin: 20px auto; /* Centers the wrapper itself horizontally on the page */
}
